<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4D3A4254"
                android:endColor="#3D252D3D" />
            <stroke
                android:width="1.5dp"
                android:color="#99FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#332A2F3D"
                android:endColor="#26171B26" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
