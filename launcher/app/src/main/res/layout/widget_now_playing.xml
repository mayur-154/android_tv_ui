<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/widget_glass_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <!-- Clickable/Focusable section that opens the audio playing app -->
    <LinearLayout
        android:id="@+id/nowPlayingOpenApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_button_glass_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusDown="@+id/grid"
        android:nextFocusRight="@+id/btnMediaPrev"
        android:nextFocusUp="@+id/widgetWeather"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp">

        <!-- Album Art / Thumbnail -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="#1AFFFFFF">

            <ImageView
                android:id="@+id/nowPlayingArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/nowPlayingPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="♫"
                android:textColor="#4DFFFFFF"
                android:textSize="22sp" />
        </FrameLayout>

        <!-- Track Metadata -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nowPlayingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fontFamily="@string/font_medium"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Not Playing"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/nowPlayingArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@string/font_light"
                android:singleLine="true"
                android:text="No active media"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nowPlayingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@string/font_regular"
                android:singleLine="true"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Playback Controls: Prev, Play/Pause, Next -->
    <LinearLayout
        android:id="@+id/nowPlayingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:focusable="false">

        <!-- Previous Button -->
        <TextView
            android:id="@+id/btnMediaPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_media_control_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:nextFocusDown="@+id/grid"
            android:nextFocusLeft="@+id/nowPlayingOpenApp"
            android:nextFocusRight="@+id/btnMediaPlayPause"
            android:nextFocusUp="@+id/widgetWeather"
            android:text="⏮"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <!-- Play / Pause Button -->
        <TextView
            android:id="@+id/btnMediaPlayPause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_media_control_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:nextFocusDown="@+id/grid"
            android:nextFocusLeft="@+id/btnMediaPrev"
            android:nextFocusRight="@+id/btnMediaNext"
            android:nextFocusUp="@+id/widgetWeather"
            android:text="▶"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <!-- Next Button -->
        <TextView
            android:id="@+id/btnMediaNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_media_control_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:nextFocusDown="@+id/grid"
            android:nextFocusLeft="@+id/btnMediaPlayPause"
            android:nextFocusUp="@+id/widgetWeather"
            android:text="⏭"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
